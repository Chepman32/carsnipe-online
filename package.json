{
  "name": "carsnipe",
  "version": "0.1.0",
  "main": "main.js",
  "description": "Carsnipe - Your application description here",
  "author": "Your Name",
  "private": true,
  "homepage": "./",
  "dependencies": {
    "@reduxjs/toolkit": "^2.4.0",
    "@supabase/auth-ui-react": "^0.4.6",
    "@supabase/auth-ui-shared": "^0.1.8",
    "@supabase/supabase-js": "^2.39.0",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "animejs": "^3.2.2",
    "antd": "^5.21.2",
    "classnames": "^2.5.1",
    "firebase-admin": "^13.4.0",
    "gsap": "^3.12.7",
    "howler": "^2.2.4",
    "i18next": "^25.0.1",
    "i18next-browser-languagedetector": "^8.0.5",
    "i18next-http-backend": "^3.0.2",
    "lucide-react": "^0.462.0",
    "react": "18.3.1",
    "react-device-detect": "^2.2.3",
    "react-dom": "18.3.1",
    "react-i18next": "^15.4.1",
    "react-redux": "^9.1.2",
    "react-responsive": "^10.0.1",
    "react-router-dom": "^6.26.2",
    "react-scripts": "5.0.1",
    "react-slot-counter": "^3.3.1",
    "react-slot-machine-gen": "^1.3.3",
    "redux-persist": "^6.0.0",
    "redux-saga": "^1.3.0",
    "web-vitals": "^2.1.4"
  },
  "resolutions": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "electron": "electron .",
    "electron-dev": "NODE_ENV=development electron .",
    "package": "electron-packager . carsnipe --platform=win32 --arch=x64 --out=dist",
    "package-mac": "electron-builder --mac --x64",
    "package-win": "electron-builder --win --x64",
    "package-linux": "electron-builder --linux AppImage --x64",
    "firebase:init": "firebase init hosting",
    "firebase:deploy": "firebase deploy --only hosting",
    "firebase:serve": "firebase serve --only hosting",
    "deploy": "npm run build && firebase deploy --only hosting",
    "upload-assets": "node scripts/upload-assets.js",
    "init-storage": "firebase init storage",
    "test-upload": "node scripts/test-upload.js",
    "upload-all": "node scripts/upload-assets-admin.js",
    "make-public": "node scripts/make-files-public.js"
  },
  "build": {
    "appId": "com.yourapp.carsnipe",
    "productName": "Carsnipe",
    "files": [
      "build/**/*",
      "main.js",
      "preload.js",
      "package.json"
    ],
    "extraMetadata": {
      "main": "main.js"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "desktop": {
        "Name": "Carsnipe",
        "Comment": "Your application description here",
        "Icon": "carsnipe",
        "Type": "Application",
        "Categories": "Utility;"
      },
      "icon": "resources/carsnipe.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "resources/appIcon.icns",
      "identity": null
    },
    "win": {
      "target": "nsis",
      "icon": "resources/win-icon.ico"
    },
    "nsis": {
      "include": "resources/installer.nsh",
      "license": "resources/license.txt",
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "resources/win-icon.ico",
      "uninstallerIcon": "resources/win-icon.ico",
      "shortcutName": "Carsnipe"
    },
    "directories": {
      "output": "dist"
    }
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/plugin-proposal-private-property-in-object": "^7.21.0",
    "@babel/preset-react": "^7.25.7",
    "@testing-library/dom": "^10.4.1",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^23.6.0",
    "electron-packager": "^17.1.0",
    "firebase-tools": "^13.0.0",
    "html-webpack-plugin": "5",
    "redux": "^5.0.1",
    "source-map-explorer": "^2.5.2",
    "typescript": "^5.8.3"
  },
  "packageManager": "yarn@4.9.2+sha512.1fc009bc09d13cfd0e19efa44cbfc2b9cf6ca61482725eb35bbc5e257e093ebf4130db6dfe15d604ff4b79efd8e1e8e99b25fa7d0a6197c9f9826358d4d65c3c"
}
